# ====================
# SCALARS
# ====================
scalar DateTime
@specifiedBy(url: "https://tools.ietf.org/html/rfc3339")

# ====================
# TYPES
# ====================
type Artiste {
    id: Int!
    nom: String!
    urlArtistImage: String
    urlSocialMedia: String
    biographieComplete: String
    evenements: [Evenement!]
}

type Scene {
    id: Int!
    name: String!
    evenements: [Evenement!]
}

type Evenement {
    eventId: Int!
    eventName: String!
    startTime: DateTime!
    endTime: DateTime!
    description: String!
    longDescription: String!
    categorie: CategorieEvenement!
    artiste: Artiste!
    scene: Scene!
}

enum CategorieEvenement {
    CONCERT
    DJ_SET
    ATELIER
    ANIMATION
    SHOPPING
    RENCONTRE
    FOOD
    CEREMONIE
}

# ====================
# INPUTS
# ====================
input ArtisteInput {
    nom: String!
    urlArtistImage: String
    urlSocialMedia: String
    biographieComplete: String
}

input SceneInput {
    name: String!
}

input EvenementInput {
    eventName: String!
    startTime: DateTime!
    endTime: DateTime!
    description: String
    longDescription: String
    categorie: CategorieEvenement!
    artisteId: Int!
    sceneId: Int!
}

# ====================
# QUERIES
# ====================
type Query {
    # Artistes
    artistes: [Artiste!]!
    artiste(id: Int!): Artiste

    # Scenes
    scenes: [Scene!]!
    scene(id: Int!): Scene

    # Evenements
    evenements: [Evenement!]!
    evenement(id: Int!): Evenement
    evenementsByArtiste(artisteId: Int!): [Evenement!]!
    evenementsByScene(sceneId: Int!): [Evenement!]!
}

# ====================
# MUTATIONS
# ====================
type Mutation {
    # Artiste mutations
    createArtiste(input: ArtisteInput!): Artiste!
    updateArtiste(id: Int!, input: ArtisteInput!): Artiste!
    deleteArtiste(id: Int!): Boolean!

    # Scene mutations
    createScene(input: SceneInput!): Scene!
    updateScene(id: Int!, input: SceneInput!): Scene!
    deleteScene(id: Int!): Boolean!

    # Evenement mutations
    createEvenement(input: EvenementInput!): Evenement!
    updateEvenement(id: Int!, input: EvenementInput!): Evenement!
    deleteEvenement(id: Int!): Boolean!
}